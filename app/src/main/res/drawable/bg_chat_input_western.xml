<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Base de cuero/madera oscura -->
    <item>
        <shape android:shape="rectangle">
            <solid android:color="#4A2415" />
            <corners android:radius="16dp" />
        </shape>
    </item>
    <!-- Interior de pergamino -->
    <item android:left="3dp" android:top="3dp" android:right="3dp" android:bottom="3dp">
        <shape android:shape="rectangle">
            <gradient android:angle="90" android:startColor="#FFF3D7" android:centerColor="#F4D9A8" android:endColor="#EAC58B" android:type="linear" />
            <stroke android:width="1dp" android:color="#B77A35" />
            <corners android:radius="13dp" />
            <padding android:left="12dp" android:top="8dp" android:right="12dp" android:bottom="8dp" />
        </shape>
    </item>
</layer-list>
