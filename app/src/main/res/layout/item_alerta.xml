<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="116dp"
    android:layout_marginStart="1dp"
    android:layout_marginEnd="1dp"
    android:layout_marginBottom="2dp"
    android:background="@android:color/transparent"
    android:clipChildren="false"
    android:clipToPadding="false">

    <ImageView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:contentDescription="Tarjeta de historial en pergamino"
        android:scaleType="fitXY"
        android:src="@drawable/alerts_history_card" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="14dp"
        android:paddingEnd="15dp"
        android:paddingTop="8dp"
        android:paddingBottom="8dp">

        <ImageView
            android:id="@+id/imgAlertaIcono"
            android:layout_width="50dp"
            android:layout_height="52dp"
            android:contentDescription="Icono de alerta"
            android:scaleType="fitCenter"
            android:src="@drawable/alerts_red_siren" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="9dp"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/txtAlertaIdentidad"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:fontFamily="serif"
                android:maxLines="1"
                android:text="Nombre · #Vivienda"
                android:textColor="#4A2415"
                android:textSize="14sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/txtAlertaEstado"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="3dp"
                android:background="@drawable/bg_alert_status"
                android:fontFamily="serif"
                android:paddingStart="7dp"
                android:paddingTop="2dp"
                android:paddingEnd="7dp"
                android:paddingBottom="2dp"
                android:text="PENDIENTE"
                android:textColor="#6D3217"
                android:textSize="10sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/txtAlertaId"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="3dp"
                android:ellipsize="middle"
                android:fontFamily="monospace"
                android:maxLines="1"
                android:text="ID: UUID"
                android:textColor="#68452B"
                android:textSize="9sp" />

            <TextView
                android:id="@+id/txtAlertaFecha"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:fontFamily="serif"
                android:text="◷ Fecha y hora"
                android:textColor="#76502F"
                android:textSize="10sp" />
        </LinearLayout>
    </LinearLayout>
</FrameLayout>
