<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android" android:layout_width="match_parent" android:layout_height="match_parent" android:background="@color/page_bg" android:fillViewport="true">
<LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="24dp">
<TextView style="@style/ScreenTitle" android:text="Crear cuenta"/>
<TextView style="@style/MutedText" android:layout_marginBottom="20dp" android:text="Regístrate para conectarte con tu comunidad."/>
<EditText android:id="@+id/txtNombre" style="@style/FormField" android:hint="Nombre completo" android:inputType="textPersonName"/>
<EditText android:id="@+id/txtVivienda" style="@style/FormField" android:layout_marginTop="12dp" android:hint="Vivienda o departamento (ej. 311A)" android:inputType="textCapCharacters"/>
<EditText android:id="@+id/txtCorreoRegistro" style="@style/FormField" android:layout_marginTop="12dp" android:hint="Correo electrónico" android:inputType="textEmailAddress"/>
<EditText android:id="@+id/txtContrasenaRegistro" style="@style/FormField" android:layout_marginTop="12dp" android:hint="Contraseña (mínimo 6 caracteres)" android:inputType="textPassword"/>
<EditText android:id="@+id/txtConfirmarContrasena" style="@style/FormField" android:layout_marginTop="12dp" android:hint="Confirmar contraseña" android:inputType="textPassword"/>
<Button android:id="@+id/btnCrearCuenta" style="@style/PrimaryButton" android:layout_marginTop="24dp" android:text="Registrarme"/>
<Button android:id="@+id/btnVolver" style="@style/SecondaryButton" android:text="Volver al inicio"/>
</LinearLayout></ScrollView>