<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="match_parent"
    android:background="@drawable/bg_page_background" android:fillViewport="true">
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
        android:orientation="vertical" android:padding="22dp">
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
            android:orientation="horizontal" android:gravity="center_vertical">
            <ImageView android:layout_width="62dp" android:layout_height="62dp"
                android:src="@drawable/western_brand" android:scaleType="fitCenter"
                android:contentDescription="Logo Comunidad Western"/>
            <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content"
                android:layout_weight="1" android:orientation="vertical" android:layout_marginStart="12dp">
                <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:text="Crear cuenta" android:textColor="@color/primary"
                    android:textSize="25sp" android:textStyle="bold" android:fontFamily="serif"/>
                <TextView style="@style/MutedText" android:text="Únete a tu comunidad."/>
            </LinearLayout>
        </LinearLayout>
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginTop="20dp" android:orientation="vertical"
            android:background="@drawable/bg_panel" android:padding="18dp" android:elevation="2dp">
            <TextView style="@style/SectionLabel" android:text="DATOS DEL RESIDENTE"/>
            <EditText android:id="@+id/txtNombre" style="@style/FormField"
                android:hint="Nombre completo" android:inputType="textPersonName"/>
            <EditText android:id="@+id/txtVivienda" style="@style/FormField"
                android:layout_marginTop="10dp" android:hint="Vivienda o departamento (ej. 311A)"
                android:inputType="textCapCharacters"/>
            <EditText android:id="@+id/txtCorreoRegistro" style="@style/FormField"
                android:layout_marginTop="10dp" android:hint="Correo electrónico" android:inputType="textEmailAddress"/>
            <EditText android:id="@+id/txtContrasenaRegistro" style="@style/FormField"
                android:layout_marginTop="10dp" android:hint="Contraseña (mínimo 6 caracteres)" android:inputType="textPassword"/>
            <EditText android:id="@+id/txtConfirmarContrasena" style="@style/FormField"
                android:layout_marginTop="10dp" android:hint="Confirmar contraseña" android:inputType="textPassword"/>
            <Button android:id="@+id/btnCrearCuenta" style="@style/PrimaryButton"
                android:layout_marginTop="20dp" android:text="Crear mi cuenta"/>
            <Button android:id="@+id/btnVolver" style="@style/SecondaryButton"
                android:text="Volver al inicio"/>
        </LinearLayout>
    </LinearLayout>
</ScrollView>