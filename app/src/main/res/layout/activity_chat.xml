<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="vertical" android:background="@drawable/bg_page_background" android:padding="16dp">
    <TextView style="@style/ScreenTitle" android:text="Chat general"/>
    <TextView style="@style/MutedText" android:text="Conversaciones entre vecinos. Nombre y vivienda acompañan cada mensaje." android:layout_marginBottom="12dp"/>
    <ListView android:id="@+id/listaMensajes" android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:background="@drawable/bg_panel" android:divider="@color/divider" android:dividerHeight="1dp" android:padding="8dp"/>
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center_vertical" android:background="@drawable/bg_panel" android:padding="8dp" android:layout_marginTop="12dp">
        <EditText android:id="@+id/txtMensaje" android:layout_width="0dp" android:layout_height="52dp" android:layout_weight="1" android:background="@drawable/bg_input" android:hint="Escribe un mensaje" android:padding="12dp" android:inputType="textCapSentences" android:textColor="@color/text_main" android:textColorHint="@color/text_muted"/>
        <Button android:id="@+id/btnEnviarMensaje" style="@style/PrimaryButton" android:layout_width="wrap_content" android:layout_height="48dp" android:layout_marginTop="0dp" android:layout_marginStart="8dp" android:minWidth="84dp" android:text="Enviar"/>
    </LinearLayout>
    <Button android:id="@+id/btnVolverChat" style="@style/TextAction" android:text="Volver"/>
</LinearLayout>