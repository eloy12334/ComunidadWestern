<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android" android:layout_width="match_parent" android:layout_height="match_parent" android:background="@color/page_bg">
<LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="22dp">
<TextView style="@style/ScreenTitle" android:text="Mi perfil"/>
<TextView style="@style/MutedText" android:layout_marginTop="12dp" android:text="Correo"/>
<TextView android:id="@+id/txtCorreoPerfil" android:layout_width="match_parent" android:layout_height="wrap_content" android:textColor="@color/text_main" android:textSize="16sp"/>
<TextView style="@style/MutedText" android:layout_marginTop="14dp" android:text="Nombre mostrado"/>
<EditText android:id="@+id/txtNombrePerfil" style="@style/FormField" android:hint="Nombre"/>
<TextView style="@style/MutedText" android:layout_marginTop="14dp" android:text="Vivienda"/>
<EditText android:id="@+id/txtViviendaPerfil" style="@style/FormField" android:hint="Ej. 311A"/>
<TextView style="@style/MutedText" android:layout_marginTop="14dp" android:text="Rol"/>
<TextView android:id="@+id/txtRolPerfil" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Vecino" android:textColor="@color/primary" android:textStyle="bold"/>
<Button android:id="@+id/btnGuardarPerfil" style="@style/PrimaryButton" android:text="Guardar cambios"/>
<Button android:id="@+id/btnCerrarSesionPerfil" style="@style/SecondaryButton" android:text="Cerrar sesión"/>
<Button android:id="@+id/btnVolverPerfil" style="@style/TextAction" android:text="Volver"/>
</LinearLayout></ScrollView>