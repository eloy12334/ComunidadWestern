<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/ann_wood_background"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_horizontal"
        android:orientation="vertical"
        android:paddingStart="13dp"
        android:paddingEnd="13dp"
        android:paddingTop="8dp"
        android:paddingBottom="12dp">

        <ImageView
            android:layout_width="235dp"
            android:layout_height="112dp"
            android:contentDescription="Anuncios oficiales"
            android:scaleType="fitCenter"
            android:src="@drawable/ann_title_sign" />

        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="42dp"
            android:layout_marginTop="2dp">

            <ImageView
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:scaleType="fitXY"
                android:src="@drawable/ann_description_banner" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:fontFamily="serif"
                android:gravity="center"
                android:text="COMUNICADO DE LA COMUNIDAD"
                android:textColor="#4A2415"
                android:textSize="12sp"
                android:textStyle="bold" />
        </FrameLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:background="@drawable/ann_notice_board"
            android:orientation="vertical"
            android:paddingStart="27dp"
            android:paddingEnd="27dp"
            android:paddingTop="28dp"
            android:paddingBottom="29dp">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:fontFamily="serif"
                android:gravity="center"
                android:text="✦ ANUNCIO OFICIAL ✦"
                android:textColor="#8A4C1C"
                android:textSize="12sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/txtDetalleTitulo"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:fontFamily="serif"
                android:gravity="center"
                android:text="Anuncio"
                android:textColor="#402112"
                android:textSize="22sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/txtDetalleAutor"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="9dp"
                android:fontFamily="serif"
                android:gravity="center"
                android:text="Publicado por"
                android:textColor="#86562E"
                android:textSize="12sp" />

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:layout_marginTop="15dp"
                android:background="#B8793E" />

            <TextView
                android:id="@+id/txtDetalleCuerpo"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:fontFamily="serif"
                android:lineSpacingExtra="4dp"
                android:textColor="#392316"
                android:textSize="16sp" />
        </LinearLayout>

        <FrameLayout
            android:layout_width="170dp"
            android:layout_height="52dp"
            android:layout_marginTop="14dp">

            <ImageView
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:scaleType="fitXY"
                android:src="@drawable/ann_back_button" />

            <Button
                android:id="@+id/btnVolverDetalleAnuncio"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:background="@android:color/transparent"
                android:fontFamily="serif"
                android:stateListAnimator="@null"
                android:text="VOLVER A ANUNCIOS"
                android:textAllCaps="false"
                android:textColor="#FFF0D4"
                android:textSize="12sp"
                android:textStyle="bold" />
        </FrameLayout>
    </LinearLayout>
</ScrollView>
