<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android" android:layout_width="match_parent" android:layout_height="match_parent" android:background="@drawable/bg_page_background">
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="20dp">
        <TextView style="@style/SectionLabel" android:text="INFORMACIÓN OFICIAL"/>
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:background="@drawable/bg_panel" android:padding="20dp" android:layout_marginTop="8dp" android:elevation="2dp">
            <TextView android:id="@+id/txtDetalleTitulo" style="@style/ScreenTitle" android:text="Anuncio"/>
            <TextView android:id="@+id/txtDetalleAutor" style="@style/MutedText" android:layout_marginTop="8dp" android:text="Publicado por"/>
            <TextView android:id="@+id/txtDetalleCuerpo" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="22dp" android:background="@drawable/bg_input" android:padding="16dp" android:textColor="@color/text_main" android:textSize="16sp" android:lineSpacingExtra="3dp"/>
        </LinearLayout>
        <Button android:id="@+id/btnVolverDetalleAnuncio" style="@style/SecondaryButton" android:text="Volver a anuncios"/>
    </LinearLayout>
</ScrollView>