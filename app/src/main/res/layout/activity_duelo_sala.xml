<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="match_parent"
    android:background="@color/page_bg" android:fillViewport="true">
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
        android:orientation="vertical" android:padding="14dp">
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
            android:gravity="center_vertical" android:orientation="horizontal">
            <TextView android:id="@+id/txtCodigoSalaTitulo" android:layout_width="0dp"
                android:layout_height="wrap_content" android:layout_weight="1"
                android:text="SALA: ------" android:textColor="@color/primary"
                android:textSize="20sp" android:textStyle="bold"/>
            <Button android:id="@+id/btnCopiarCodigo" android:layout_width="wrap_content"
                android:layout_height="42dp" android:text="COPIAR"
                android:textAllCaps="false" android:backgroundTint="@color/secondary"
                android:textColor="@color/on_primary"/>
        </LinearLayout>
        <com.example.comunidadwestern.WesternSceneView
            android:layout_width="match_parent" android:layout_height="176dp"
            android:layout_marginTop="10dp" android:background="@drawable/bg_western_panel"
            android:contentDescription="Escenario ilustrado del duelo del oeste"/>
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
            android:orientation="horizontal" android:gravity="center"
            android:background="@drawable/bg_western_panel" android:padding="12dp"
            android:layout_marginTop="10dp">
            <TextView android:id="@+id/txtTuNombre" android:layout_width="0dp"
                android:layout_height="wrap_content" android:layout_weight="1"
                android:text="TÚ" android:textColor="@color/on_primary" android:textStyle="bold"
                android:gravity="center" android:textSize="15sp"/>
            <TextView android:id="@+id/txtMarcador" android:layout_width="wrap_content"
                android:layout_height="wrap_content" android:text="0 — 0"
                android:textColor="@color/gold" android:textSize="22sp" android:textStyle="bold"
                android:paddingHorizontal="10dp"/>
            <TextView android:id="@+id/txtRivalNombre" android:layout_width="0dp"
                android:layout_height="wrap_content" android:layout_weight="1"
                android:text="RIVAL" android:textColor="@color/on_primary" android:textStyle="bold"
                android:gravity="center" android:textSize="15sp"/>
        </LinearLayout>
        <TextView android:id="@+id/txtRonda" android:layout_width="match_parent"
            android:layout_height="wrap_content" android:text="MEJOR DE 3"
            android:textColor="#6D321A" android:textSize="16sp" android:textStyle="bold"
            android:gravity="center" android:layout_marginTop="12dp"/>
        <TextView android:id="@+id/txtCuenta" android:layout_width="116dp"
            android:layout_height="116dp" android:layout_gravity="center"
            android:layout_marginTop="8dp" android:background="@drawable/bg_western_timer"
            android:gravity="center" android:text="VS" android:textColor="#FFE2A1"
            android:textSize="46sp" android:textStyle="bold"/>
        <TextView android:id="@+id/txtEstadoDuelo" android:layout_width="match_parent"
            android:layout_height="wrap_content" android:text="Esperando rival..."
            android:textColor="@color/primary" android:textSize="20sp" android:textStyle="bold"
            android:gravity="center" android:layout_marginTop="12dp"/>
        <TextView android:id="@+id/txtDetalleDuelo" android:layout_width="match_parent"
            android:layout_height="wrap_content" android:text="Comparte el código de sala."
            android:textColor="@color/text_muted" android:textSize="14sp" android:gravity="center"
            android:layout_marginTop="4dp"/>
        <Button android:id="@+id/btnDisparar" android:layout_width="match_parent"
            android:layout_height="66dp" android:layout_marginTop="16dp"
            android:background="@drawable/bg_western_red_button" android:text="¡DISPARAR!"
            android:textColor="@color/on_primary" android:textSize="21sp" android:textStyle="bold"
            android:enabled="false" android:textAllCaps="false"/>
        <Button android:id="@+id/btnAccionSala" android:layout_width="match_parent"
            android:layout_height="54dp" android:layout_marginTop="10dp"
            android:background="@drawable/bg_western_gold_button" android:text="INICIAR DUELO"
            android:textColor="@color/primary" android:textStyle="bold" android:visibility="gone"
            android:textAllCaps="false"/>
        <Button android:id="@+id/btnSalirSala" android:layout_width="match_parent"
            android:layout_height="46dp" android:layout_marginTop="5dp"
            android:backgroundTint="@color/primary" android:text="SALIR DE LA SALA"
            android:textColor="@color/on_primary" android:textAllCaps="false"/>
    </LinearLayout>
</ScrollView>
