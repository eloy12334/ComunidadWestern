<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/duel_wood_dark"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:gravity="center_horizontal"
        android:paddingStart="14dp"
        android:paddingEnd="14dp"
        android:paddingTop="12dp"
        android:paddingBottom="18dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <TextView
                android:id="@+id/txtCodigoSalaTitulo"
                android:layout_width="0dp"
                android:layout_height="54dp"
                android:layout_weight="1"
                android:background="@drawable/bg_western_panel"
                android:gravity="center_vertical"
                android:paddingStart="16dp"
                android:paddingEnd="5dp"
                android:text="SALA: ------"
                android:textColor="@color/duel_parchment_light"
                android:textSize="18sp"
                android:textStyle="bold"
                android:singleLine="true" />

            <Button
                android:id="@+id/btnCopiarCodigo"
                android:layout_width="102dp"
                android:layout_height="48dp"
                android:layout_marginStart="6dp"
                android:background="@drawable/duel_btn_copiar"
                android:backgroundTint="@null"
                android:stateListAnimator="@null"
                android:insetLeft="0dp"
                android:insetRight="0dp"
                android:padding="0dp"
                android:text=""
                android:contentDescription="Copiar código de sala" />
        </LinearLayout>

        <ImageView
            android:layout_width="match_parent"
            android:layout_height="125dp"
            android:layout_marginTop="10dp"
            android:src="@drawable/duel_bg_standoff_cowboys"
            android:scaleType="centerCrop"
            android:contentDescription="Dos pistoleros enfrentados en la calle principal" />

        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="82dp"
            android:layout_marginTop="7dp"
            android:background="@drawable/duel_panel_modo_juego">

            <TextView
                android:id="@+id/txtTuNombre"
                android:layout_width="106dp"
                android:layout_height="match_parent"
                android:layout_gravity="start|center_vertical"
                android:gravity="center"
                android:paddingStart="3dp"
                android:paddingEnd="2dp"
                android:text="TÚ"
                android:textColor="@color/duel_ink"
                android:textSize="11sp"
                android:textStyle="bold"
                android:maxLines="3"
                android:ellipsize="end" />

            <TextView
                android:id="@+id/txtMarcador"
                android:layout_width="94dp"
                android:layout_height="match_parent"
                android:layout_gravity="center"
                android:gravity="center"
                android:text="0 — 0"
                android:textColor="#9B5A13"
                android:textSize="22sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/txtRivalNombre"
                android:layout_width="106dp"
                android:layout_height="match_parent"
                android:layout_gravity="end|center_vertical"
                android:gravity="center"
                android:paddingStart="2dp"
                android:paddingEnd="3dp"
                android:text="RIVAL"
                android:textColor="@color/duel_ink"
                android:textSize="11sp"
                android:textStyle="bold"
                android:maxLines="3"
                android:ellipsize="end" />
        </FrameLayout>

        <FrameLayout
            android:layout_width="228dp"
            android:layout_height="70dp"
            android:layout_marginTop="4dp"
            android:background="@drawable/duel_panel_modo_juego">

            <TextView
                android:id="@+id/txtRonda"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:gravity="center"
                android:text="MEJOR DE 1"
                android:textColor="@color/duel_ink"
                android:textSize="14sp"
                android:textStyle="bold" />
        </FrameLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center"
            android:layout_marginTop="2dp">
            <ImageView
                android:layout_width="68dp"
                android:layout_height="38dp"
                android:src="@drawable/duel_revolveres_cruzados"
                android:scaleType="fitCenter"
                android:contentDescription="Revólveres cruzados" />
            <ImageView
                android:layout_width="64dp"
                android:layout_height="66dp"
                android:layout_marginStart="8dp"
                android:layout_marginEnd="8dp"
                android:src="@drawable/duel_insignia_vs"
                android:scaleType="fitCenter"
                android:contentDescription="Insignia de enfrentamiento" />
            <ImageView
                android:layout_width="44dp"
                android:layout_height="38dp"
                android:src="@drawable/duel_balas_revolver"
                android:scaleType="fitCenter"
                android:contentDescription="Balas de revólver" />
        </LinearLayout>

        <FrameLayout
            android:layout_width="106dp"
            android:layout_height="106dp"
            android:layout_marginTop="1dp">

            <TextView
                android:id="@+id/txtCuenta"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:background="@drawable/bg_duel_countdown"
                android:gravity="center"
                android:text="VS"
                android:textColor="@color/duel_parchment_light"
                android:textSize="34sp"
                android:textStyle="bold"
                android:autoSizeTextType="uniform"
                android:autoSizeMinTextSize="18sp"
                android:autoSizeMaxTextSize="34sp"
                android:autoSizeStepGranularity="2sp"
                android:shadowColor="#99000000"
                android:shadowRadius="3"
                android:shadowDx="1"
                android:shadowDy="2" />
        </FrameLayout>

        <ImageView
            android:layout_width="28dp"
            android:layout_height="36dp"
            android:layout_marginTop="3dp"
            android:src="@drawable/duel_reloj_arena"
            android:scaleType="fitCenter"
            android:contentDescription="Cuenta regresiva aleatoria" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="5dp"
            android:background="@drawable/duel_panel_reglas"
            android:gravity="center"
            android:orientation="vertical"
            android:paddingStart="18dp"
            android:paddingEnd="18dp"
            android:paddingTop="13dp"
            android:paddingBottom="13dp">

            <TextView
                android:id="@+id/txtEstadoDuelo"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:text="Esperando que se una tu rival..."
                android:textColor="@color/duel_ink"
                android:textSize="17sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/txtDetalleDuelo"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:gravity="center"
                android:text="Comparte el código de sala para jugar 1 vs. 1."
                android:textColor="@color/duel_ink"
                android:textSize="13sp" />
        </LinearLayout>

        <Button
            android:id="@+id/btnDisparar"
            android:layout_width="310dp"
            android:layout_height="94dp"
            android:layout_marginTop="2dp"
            android:background="@drawable/duel_btn_disparar"
            android:backgroundTint="@null"
            android:stateListAnimator="@null"
            android:insetLeft="0dp"
            android:insetRight="0dp"
            android:padding="0dp"
            android:text=""
            android:enabled="false"
            android:contentDescription="Disparar" />

        <Button
            android:id="@+id/btnAccionSala"
            android:layout_width="match_parent"
            android:layout_height="54dp"
            android:layout_marginTop="-3dp"
            android:background="@drawable/bg_western_gold_button"
            android:text="INICIAR DUELO"
            android:textColor="@color/duel_ink"
            android:textStyle="bold"
            android:visibility="gone"
            android:textAllCaps="false" />

        <Button
            android:id="@+id/btnSalirSala"
            android:layout_width="260dp"
            android:layout_height="82dp"
            android:layout_marginTop="-3dp"
            android:background="@drawable/duel_btn_salir_sala"
            android:backgroundTint="@null"
            android:stateListAnimator="@null"
            android:insetLeft="0dp"
            android:insetRight="0dp"
            android:padding="0dp"
            android:text=""
            android:contentDescription="Salir de la sala" />

    </LinearLayout>
</ScrollView>
