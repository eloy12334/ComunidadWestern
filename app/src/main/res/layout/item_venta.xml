<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/contenedorVenta"
    android:layout_width="match_parent"
    android:layout_height="116dp"
    android:layout_marginBottom="3dp"
    android:clipChildren="false"
    android:clipToPadding="false">

    <ImageView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:contentDescription="Tarjeta de producto"
        android:scaleType="fitXY"
        android:src="@drawable/sales_product_card" />

    <ImageView
        android:id="@+id/imgIconoProducto"
        android:layout_width="53dp"
        android:layout_height="53dp"
        android:layout_gravity="start|center_vertical"
        android:layout_marginStart="15dp"
        android:contentDescription="Producto publicado"
        android:scaleType="fitCenter"
        android:src="@drawable/sales_crate" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="82dp"
        android:layout_marginEnd="12dp"
        android:layout_marginTop="12dp"
        android:orientation="vertical">

        <TextView
            android:id="@+id/txtVentaTitulo"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:maxLines="1"
            android:text="Mesa plegable"
            android:textColor="#492614"
            android:textSize="14sp"
            android:textStyle="bold" />

        <FrameLayout
            android:layout_width="116dp"
            android:layout_height="32dp"
            android:layout_marginTop="1dp">

            <ImageView
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:scaleType="fitXY"
                android:src="@drawable/sales_price_tag" />

            <TextView
                android:id="@+id/txtVentaPrecio"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:gravity="center"
                android:paddingStart="20dp"
                android:paddingEnd="3dp"
                android:text="$15.000 CLP"
                android:textColor="#FFF0D0"
                android:textSize="10sp"
                android:textStyle="bold" />
        </FrameLayout>

        <TextView
            android:id="@+id/txtVentaDescripcion"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:maxLines="1"
            android:text="En buen estado, poco uso"
            android:textColor="#5D3B25"
            android:textSize="10sp" />

        <TextView
            android:id="@+id/txtVentaVendedor"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:maxLines="1"
            android:text="eloy · #311A · 24/11 18:47"
            android:textColor="#76502F"
            android:textSize="9sp" />
    </LinearLayout>

    <ImageView
        android:id="@+id/imgVentaVendido"
        android:layout_width="76dp"
        android:layout_height="42dp"
        android:layout_gravity="top|end"
        android:layout_marginTop="5dp"
        android:layout_marginEnd="4dp"
        android:contentDescription="Producto vendido"
        android:rotation="8"
        android:scaleType="fitCenter"
        android:src="@drawable/sales_sold_stamp"
        android:visibility="gone" />
</FrameLayout>
