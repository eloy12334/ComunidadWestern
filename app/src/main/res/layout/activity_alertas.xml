<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="vertical" android:background="@drawable/bg_page_background" android:padding="18dp">
    <TextView style="@style/ScreenTitle" android:text="Alertas comunitarias"/>
    <TextView android:id="@+id/txtEstadoMqtt" style="@style/MutedText" android:layout_marginTop="2dp" android:text="Comprobando MQTT..."/>
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="16dp" android:background="@drawable/bg_panel" android:padding="14dp" android:orientation="vertical">
        <TextView style="@style/SectionLabel" android:text="AVISO DE EMERGENCIA"/>
        <Button android:id="@+id/btnActivarAlerta" android:layout_width="match_parent" android:layout_height="64dp" android:background="@drawable/bg_button_danger" android:text="ACTIVAR ALERTA" android:textColor="@color/on_danger" android:textStyle="bold" android:textSize="17sp" android:textAllCaps="false"/>
    </LinearLayout>
    <TextView style="@style/SectionLabel" android:layout_marginTop="20dp" android:text="HISTORIAL DE ALERTAS"/>
    <ListView android:id="@+id/listaAlertas" android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:background="@drawable/bg_panel" android:divider="@color/divider" android:dividerHeight="1dp" android:padding="8dp"/>
    <Button android:id="@+id/btnVolverAlertas" style="@style/TextAction" android:text="Volver"/>
</LinearLayout>