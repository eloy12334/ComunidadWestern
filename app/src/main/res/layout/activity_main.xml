<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="match_parent"
    android:background="@drawable/bg_page_background" android:fillViewport="true">
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
        android:orientation="vertical" android:gravity="center_horizontal"
        android:paddingStart="24dp" android:paddingEnd="24dp" android:paddingTop="28dp" android:paddingBottom="24dp">
        <ImageView android:layout_width="126dp" android:layout_height="126dp"
            android:src="@drawable/western_brand" android:scaleType="fitCenter"
            android:contentDescription="Icono de Comunidad Western"/>
        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:layout_marginTop="10dp" android:text="@string/app_name"
            android:textColor="@color/primary" android:textSize="27sp"
            android:textStyle="bold" android:fontFamily="serif"/>
        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:layout_marginTop="5dp" android:text="@string/tagline"
            android:textColor="@color/text_muted" android:textSize="13sp"
            android:fontFamily="sans"/>

        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginTop="24dp" android:orientation="vertical"
            android:background="@drawable/bg_panel" android:elevation="3dp" android:padding="20dp">
            <TextView style="@style/SectionLabel" android:text="ACCESO DE RESIDENTES"/>
            <EditText android:id="@+id/txtCorreo" style="@style/FormField"
                android:layout_marginTop="8dp" android:hint="Correo electrónico"
                android:inputType="textEmailAddress"/>
            <EditText android:id="@+id/txtContrasena" style="@style/FormField"
                android:layout_marginTop="12dp" android:hint="Contraseña"
                android:inputType="textPassword"/>
            <Button android:id="@+id/btnRecuperar" style="@style/TextAction"
                android:layout_marginTop="4dp" android:text="¿Olvidaste tu contraseña?"/>
            <Button android:id="@+id/btnIngresar" style="@style/PrimaryButton"
                android:layout_marginTop="8dp" android:text="Iniciar sesión"/>
            <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
                android:layout_marginTop="20dp" android:gravity="center"
                android:text="¿Aún no tienes una cuenta?" android:textColor="@color/text_muted"
                android:textSize="13sp"/>
            <Button android:id="@+id/btnIrRegistro" style="@style/SecondaryButton"
                android:layout_marginTop="8dp" android:text="Crear cuenta"/>
        </LinearLayout>
        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:layout_marginTop="18dp" android:text="TU COMUNIDAD, SIEMPRE CERCA"
            android:textColor="@color/secondary" android:textSize="10sp"
            android:textStyle="bold" android:letterSpacing="0.14"/>
    </LinearLayout>
</ScrollView>