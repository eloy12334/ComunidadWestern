<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android" android:layout_width="match_parent" android:layout_height="match_parent" android:background="@color/page_bg" android:fillViewport="true">
<LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:gravity="center_horizontal" android:padding="26dp">
    <ImageView android:layout_width="116dp" android:layout_height="116dp" android:layout_marginTop="2dp" android:src="@drawable/western_cowboy_chat" android:scaleType="fitCenter" android:contentDescription="Vaquero de Comunidad Western"/>
    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="18dp" android:text="@string/app_name" android:textColor="@color/primary" android:textSize="26sp" android:textStyle="bold" android:fontFamily="@string/brand_font"/>
    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="6dp" android:text="@string/tagline" android:textColor="@color/text_muted" android:textSize="14sp"/>
    <EditText android:id="@+id/txtCorreo" style="@style/FormField" android:layout_marginTop="38dp" android:hint="Correo electrónico" android:inputType="textEmailAddress"/>
    <EditText android:id="@+id/txtContrasena" style="@style/FormField" android:layout_marginTop="12dp" android:hint="Contraseña" android:inputType="textPassword"/>
    <Button android:id="@+id/btnRecuperar" style="@style/TextAction" android:layout_marginTop="4dp" android:text="¿Olvidaste tu contraseña?"/>
    <Button android:id="@+id/btnIngresar" style="@style/PrimaryButton" android:layout_marginTop="12dp" android:text="Iniciar sesión"/>
    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="24dp" android:text="¿Aún no tienes una cuenta?" android:textColor="@color/text_muted"/>
    <Button android:id="@+id/btnIrRegistro" style="@style/SecondaryButton" android:text="Crear cuenta"/>
</LinearLayout></ScrollView>