<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="match_parent"
    android:background="@drawable/bg_page_background" android:fillViewport="true">
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
        android:orientation="vertical" android:padding="20dp">
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
            android:orientation="horizontal" android:gravity="center_vertical">
            <ImageView android:layout_width="68dp" android:layout_height="68dp"
                android:src="@drawable/western_brand" android:scaleType="fitCenter"
                android:contentDescription="Logo Comunidad Western"/>
            <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content"
                android:layout_weight="1" android:orientation="vertical" android:layout_marginStart="14dp">
                <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:text="@string/app_name" android:textColor="@color/primary"
                    android:textSize="22sp" android:textStyle="bold" android:fontFamily="serif"/>
                <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:text="@string/tagline" android:textColor="@color/text_muted"
                    android:textSize="12sp"/>
            </LinearLayout>
        </LinearLayout>

        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
            android:orientation="vertical" android:background="@drawable/bg_panel"
            android:padding="18dp" android:layout_marginTop="20dp" android:elevation="2dp">
            <TextView android:id="@+id/txtBienvenida" style="@style/ScreenTitle"
                android:layout_marginTop="0dp" android:text="Hola, vecino"/>
            <TextView android:id="@+id/txtViviendaHome" style="@style/MutedText"
                android:layout_marginTop="4dp" android:text="Vivienda #---"/>
        </LinearLayout>

        <TextView style="@style/SectionLabel" android:layout_marginTop="24dp"
            android:text="ESPACIOS DE LA COMUNIDAD"/>
        <Button android:id="@+id/btnChat" style="@style/MenuButton"
            android:drawableStart="@drawable/ic_chat" android:text="Chat general"/>
        <Button android:id="@+id/btnVentas" style="@style/MenuButton"
            android:drawableStart="@drawable/ic_store" android:text="Ventas comunitarias"/>
        <Button android:id="@+id/btnAnuncios" style="@style/MenuButton"
            android:drawableStart="@drawable/ic_announcement" android:text="Anuncios oficiales"/>
        <Button android:id="@+id/btnAlertas" style="@style/MenuButton"
            android:drawableStart="@drawable/ic_alert" android:text="Alertas comunitarias"/>
        <Button android:id="@+id/btnDuelo" style="@style/MenuButton"
            android:drawableStart="@drawable/ic_duel" android:text="Duelo del Oeste"/>
        <Button android:id="@+id/btnPerfil" style="@style/SecondaryButton"
            android:drawableStart="@drawable/ic_person" android:drawablePadding="10dp"
            android:gravity="center" android:text="Mi perfil"/>
        <Button android:id="@+id/btnCerrarSesion" style="@style/TextAction"
            android:layout_marginTop="4dp" android:text="Cerrar sesión"/>
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginTop="6dp" android:gravity="center" android:text="UNIDOS COMO EN EL VIEJO OESTE"
            android:textColor="@color/text_muted" android:textSize="10sp" android:letterSpacing="0.12"/>
    </LinearLayout>
</ScrollView>