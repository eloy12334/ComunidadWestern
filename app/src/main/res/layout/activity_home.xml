<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_home_western_scene">

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true"
        android:clipToPadding="false"
        android:scrollbars="none">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:gravity="center_horizontal"
            android:paddingStart="14dp"
            android:paddingEnd="14dp"
            android:paddingTop="4dp"
            android:paddingBottom="18dp">

            <ImageView
                android:id="@+id/imgLogoHome"
                android:layout_width="match_parent"
                android:layout_height="168dp"
                android:src="@drawable/menu_logo_western"
                android:scaleType="fitCenter"
                android:contentDescription="Comunidad Western, emblema del viejo oeste" />

            <TextView
                android:id="@+id/txtBienvenida"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="0dp"
                android:gravity="center"
                android:text="Hola, vecino"
                android:textColor="#4A2415"
                android:textSize="25sp"
                android:textStyle="bold"
                android:shadowColor="#80FFF0CE"
                android:shadowDx="0"
                android:shadowDy="2"
                android:shadowRadius="3" />

            <TextView
                android:id="@+id/txtViviendaHome"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:layout_marginTop="1dp"
                android:text="Vivienda #---"
                android:textColor="#61391F"
                android:textSize="15sp"
                android:letterSpacing="0.04"
                android:shadowColor="#80FFF0CE"
                android:shadowDx="0"
                android:shadowDy="1"
                android:shadowRadius="2" />

            <ImageView
                android:layout_width="match_parent"
                android:layout_height="46dp"
                android:layout_marginTop="7dp"
                android:src="@drawable/menu_section_community"
                android:scaleType="fitCenter"
                android:contentDescription="Espacios de la comunidad" />

            <ImageButton
                android:id="@+id/btnChat"
                android:layout_width="match_parent"
                android:layout_height="65dp"
                android:layout_marginTop="1dp"
                android:padding="0dp"
                android:background="@drawable/menu_button_ripple"
                android:src="@drawable/menu_btn_chat"
                android:scaleType="fitCenter"
                android:contentDescription="Abrir chat general" />

            <ImageButton
                android:id="@+id/btnVentas"
                android:layout_width="match_parent"
                android:layout_height="65dp"
                android:layout_marginTop="1dp"
                android:padding="0dp"
                android:background="@drawable/menu_button_ripple"
                android:src="@drawable/menu_btn_sales"
                android:scaleType="fitCenter"
                android:contentDescription="Abrir ventas comunitarias" />

            <ImageButton
                android:id="@+id/btnAnuncios"
                android:layout_width="match_parent"
                android:layout_height="65dp"
                android:layout_marginTop="1dp"
                android:padding="0dp"
                android:background="@drawable/menu_button_ripple"
                android:src="@drawable/menu_btn_announcements"
                android:scaleType="fitCenter"
                android:contentDescription="Abrir anuncios oficiales" />

            <ImageButton
                android:id="@+id/btnAlertas"
                android:layout_width="match_parent"
                android:layout_height="65dp"
                android:layout_marginTop="1dp"
                android:padding="0dp"
                android:background="@drawable/menu_button_ripple"
                android:src="@drawable/menu_btn_alerts"
                android:scaleType="fitCenter"
                android:contentDescription="Abrir alertas comunitarias" />

            <ImageButton
                android:id="@+id/btnDuelo"
                android:layout_width="match_parent"
                android:layout_height="65dp"
                android:layout_marginTop="1dp"
                android:padding="0dp"
                android:background="@drawable/menu_button_ripple"
                android:src="@drawable/menu_btn_duel"
                android:scaleType="fitCenter"
                android:contentDescription="Abrir Duelo del Oeste" />

            <ImageButton
                android:id="@+id/btnPerfil"
                android:layout_width="match_parent"
                android:layout_height="65dp"
                android:layout_marginTop="3dp"
                android:padding="0dp"
                android:background="@drawable/menu_button_ripple"
                android:src="@drawable/menu_btn_profile"
                android:scaleType="fitCenter"
                android:contentDescription="Abrir mi perfil" />

            <ImageButton
                android:id="@+id/btnCerrarSesion"
                android:layout_width="match_parent"
                android:layout_height="64dp"
                android:layout_marginTop="0dp"
                android:padding="0dp"
                android:background="@drawable/menu_button_ripple"
                android:src="@drawable/menu_btn_logout"
                android:scaleType="fitCenter"
                android:contentDescription="Cerrar sesión" />

        </LinearLayout>
    </ScrollView>
</FrameLayout>
